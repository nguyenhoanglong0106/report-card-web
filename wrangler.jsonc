{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phieu-bao-diem",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "rules": [
    { "type": "Data", "globs": ["**/*.docx"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true
  }
}
